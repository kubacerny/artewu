---
import { GTM_ID } from 'astro:env/client';
import '../styles/global.css';
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Truhlářství Plzeň – nábytek z masivu na míru | Artewu',
  description = 'Zakázkové truhlářství pro Plzeň a okolí. Vyrábíme nábytek z masivu, kuchyně, stoly, vestavěné skříně a interiérové prvky na míru.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://artewu.com/#business',
  name: 'Artewu s.r.o.',
  url: 'https://artewu.com',
  telephone: '+420608179251',
  email: 'kuba@artewu.com',
  description:
    'Zakázkové truhlářství a výroba nábytku z masivu pro zákazníky z Plzně a okolí.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Druztová 187',
    postalCode: '330 07',
    addressLocality: 'Druztová',
    addressRegion: 'Plzeňský kraj',
    addressCountry: 'CZ',
  },
  areaServed: [
    { '@type': 'City', name: 'Plzeň' },
    { '@type': 'AdministrativeArea', name: 'Plzeň-sever' },
    { '@type': 'Place', name: 'Druztová' },
  ],
  knowsAbout: [
    'nábytek z masivu',
    'nábytek na míru',
    'kuchyně na míru',
    'vestavěné skříně',
    'jídelní stoly',
    'dřevěná schodiště',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Truhlářské služby',
    itemListElement: [
      'Nábytek z masivu na míru',
      'Kuchyně na míru',
      'Vestavěné skříně',
      'Stoly a sedací nábytek',
      'Interiérové dveře a obklady',
    ].map((name) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name,
        areaServed: 'Plzeň a okolí',
      },
    })),
  },
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google tag (gtag.js) -->
    {
      GTM_ID && (
        <Fragment>
          <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`} />
          <script is:inline define:vars={{ GTM_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', GTM_ID);
          </script>
        </Fragment>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Fonts loaded non-blocking:
      1. preload as fetch so the browser discovers the URL early
      2. rel="stylesheet" with media="print" so it doesn't block render
      3. onload switches media to "all" once loaded
      4. <noscript> fallback for JS-disabled browsers
    -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Artewu s.r.o." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header client:load currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
